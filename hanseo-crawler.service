[Unit]
Description=Hanseo Mate FastAPI Crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hsmate
Group=hsmate
WorkingDirectory=/opt/hanseo-mate/crawler/source

ExecStart=/opt/hanseo-mate/crawler/source/.venv/bin/python -m uvicorn api_main:app --host 127.0.0.1 --port 8000

Environment=PYTHONUNBUFFERED=1

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
